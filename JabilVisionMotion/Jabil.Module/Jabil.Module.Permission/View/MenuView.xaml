<UserControl x:Class="Jabil.Module.Permission.View.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jabil.Module.Permission.View"
             xmlns:lib="clr-namespace:Jabil.Lib;assembly=Jabil.Lib"


             xmlns:comm="clr-namespace:Jabil.Module.Permission.Common"
             xmlns:permission="clr-namespace:Jabil.Module.Permission"
             xmlns:matrial="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"  Background="#003764"  FontSize="12" Foreground="#14BDEF" 
             Height="{Binding Source={x:Static permission:MenuProxy.Instance},Path=TitleHeight}" MinWidth="1200" MinHeight="80"
             d:DesignHeight="120" d:DesignWidth="1200" x:Name="menu">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Jabil.Module.Permission;component/Permission.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <comm:PermissionVisibilityConverter x:Key="perConvert"/>
            <comm:MenuHeightConverter  x:Key="itemHeight" />
            <comm:PauseStatusIconConverter x:Key="pauseConverter"/>
            <comm:MachineRunStatusConverter x:Key="machineStatusConverter"/>


            <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignButtonTextBlock}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="FontStyle" Value="Normal"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4,3"/>
            </Style>
            <ObjectDataProvider x:Key="operateData" MethodName="GetValues" ObjectType="{x:Type lib:OperateMode}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="lib:OperateMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="10,2">

            <Image    Stretch="Uniform" Height="auto" Margin="2,2,25,2" Width="180"  Source="{Binding Source={x:Static permission:BitmapFactory.LoginTitle}}" />
            <ListBox  Background="Transparent" Width="auto" Height="{Binding ElementName=menu,Path=Height}"  Style="{StaticResource  MaterialDesignNavigationPrimaryListBox}" SelectedIndex="0"
                      matrial:ListBoxItemAssist.HoverBackground="Black"
                      SelectedItem="{Binding Source={x:Static permission:PermissionSystem.Instance},Path=SelectMenu,UpdateSourceTrigger=PropertyChanged}"
                   ItemsSource="{Binding Source={x:Static permission:PermissionSystem.Instance},Path=Menus,UpdateSourceTrigger=PropertyChanged}"  
                   VerticalAlignment="Center">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignNavigationPrimaryListBoxItem}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected , RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Background" Value="Azure" />
                                <Setter Property="Foreground" Value="CadetBlue" />
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                    </ControlTemplate>
                </ListBox.Template>

                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type comm:MenuDto}">
                        <ContentControl Foreground="#14BDEF"  VerticalAlignment="Center" HorizontalAlignment="Center"   Margin="0,2,0,2" Padding="0"
                            >

                            <Grid HorizontalAlignment="Left" Width="{Binding Height,RelativeSource={RelativeSource Mode=Self}}" 
                                  Height="{Binding Height,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox},Converter={StaticResource itemHeight},ConverterParameter=7}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <matrial:PackIcon Kind="{Binding Icon}" Width="{Binding Height,RelativeSource={RelativeSource Mode=Self}}"
                                                  Height="{Binding Height,RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Grid},Converter={StaticResource itemHeight},ConverterParameter=7}"
                                                      Foreground="White" 
                                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Text="{Binding TitleName}" HorizontalAlignment="Center" Margin="0,2,0,2" Style="{x:Null}" />
                            </Grid>
                        </ContentControl>
                    </DataTemplate>


                </ListBox.Resources>


            </ListBox>

        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="{Binding ElementName=menu,Path=Background}">
            <Border  BorderThickness="1" Margin="10" BorderBrush="#A2D8F1" Padding="5,0">
                <Grid x:Name="machine">
                    <TextBlock Text="{Binding Source={x:Static permission:MenuProxy.Instance},Path=MachineRunModel}" Foreground="#A2D8F1" Margin="2,-7,0,0" Background="#003764"  VerticalAlignment="Top" HorizontalAlignment="Left"></TextBlock>
                    <TextBlock Text="{Binding Source={x:Static permission:MenuProxy.Instance},Path=MachineRunStatus,Converter={StaticResource machineStatusConverter}}" Foreground="#A2D8F1" Margin="60,-7,0,0" Background="#003764"  VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <ComboBox SelectedValue="{Binding Source={x:Static permission:MenuProxy.Instance},Path=OperateType}"
                              ItemsSource="{Binding Source={StaticResource operateData} }"
                              Visibility="{Binding Source={x:Static permission:MenuProxy.Instance},Path=EnableMachineRunType,Converter={StaticResource BooleanToVisibilityConverter}}"
                              Width="50" Padding="0" FontSize="12"  Foreground="#A2D8F1" Margin="132,-8,0,0"  Background="#003764"  VerticalAlignment="Top" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#A2D8F1" Text="{Binding }"/>
                            </DataTemplate>
            
                        </ComboBox.ItemTemplate>
       
                    </ComboBox>




                    <StackPanel x:Name="op" Orientation="Horizontal">

                        <Button Style="{StaticResource  MaterialDesignIconButton}" Foreground="#6FB002" IsEnabled="{Binding Source={x:Static permission:MenuProxy.Instance },Path=EnableStart}"
                                Command="{x:Static permission:MenuProxy.OpenCommand}" CommandParameter="运行" ToolTip="运行">
                            <matrial:PackIcon Kind="Play"  Height="40" Width="40"/>
                        </Button>
                        <Button Style="{StaticResource  MaterialDesignIconButton}" Foreground="#A2D8F1" IsEnabled="{Binding Source={x:Static permission:MenuProxy.Instance },Path=EnablePause}"
                                Command="{x:Static permission:MenuProxy.OpenCommand}" CommandParameter="暂停" ToolTip="暂停/继续">
                            <matrial:PackIcon Kind="{Binding Source={x:Static permission:MenuProxy.Instance}, Path=PauseStatus,Converter={StaticResource pauseConverter}}"  Height="40" Width="40"/>
                        </Button>
                        <Button Style="{StaticResource  MaterialDesignIconButton}" Foreground="#F38B76" IsEnabled="{Binding Source={x:Static permission:MenuProxy.Instance },Path=EnableStop}"
                                Command="{x:Static permission:MenuProxy.OpenCommand}" CommandParameter="停止" ToolTip="停止">
                            <matrial:PackIcon Kind="Stop"  Height="40" Width="40"/>
                        </Button>
                        <Button Style="{StaticResource  MaterialDesignIconButton}" Foreground="#12B1EB" IsEnabled="{Binding Source={x:Static permission:MenuProxy.Instance },Path=EnableInit}"
                                Command="{x:Static permission:MenuProxy.OpenCommand}" CommandParameter="初始化" ToolTip="初始化">
                            <matrial:PackIcon Kind="Restart"  Height="40" Width="40"/>
                        </Button>
                        <Button Style="{StaticResource  MaterialDesignIconButton}" Foreground="#12B1EB" IsEnabled="{Binding Source={x:Static permission:MenuProxy.Instance },Path=EnableReset}"
                                ToolTip="复位"
                                Command="{x:Static permission:MenuProxy.OpenCommand}" CommandParameter="复位" Visibility="{Binding IsEnabled,RelativeSource={RelativeSource Mode=Self},Converter={StaticResource BooleanToVisibilityConverter}}">
                            <matrial:PackIcon Kind="RestoreAlert"  Height="40" Width="40"/>
                        </Button>

                    </StackPanel>
                </Grid>

            </Border>

        </StackPanel>
        <Button Grid.Column="2" Width="AUTO" Height="{Binding ElementName=op,Path=Height}" Margin="15,10" BorderBrush="#A2D8F1" 
                VerticalContentAlignment="Center"  Style="{StaticResource  MaterialDesignOutlinedButton}" 
                Command="{x:Static permission:MenuProxy.OpenCommand}" CommandParameter="退出">
            <StackPanel Orientation="Horizontal">
                <matrial:PackIcon Kind="ExitToApp" Width="40" Height="40" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="退出" FontSize="28" Margin="8,0" FontWeight="Light"/>

            </StackPanel>
        </Button>

        <matrial:Snackbar Foreground="White"
                        x:Name="MenuSnackbar" IsActive="False"
                           ActionButtonPlacement="Inline"
                        MessageQueue="{matrial:MessageQueue}"
                        Grid.ColumnSpan="4"/>
    </Grid>
</UserControl>
