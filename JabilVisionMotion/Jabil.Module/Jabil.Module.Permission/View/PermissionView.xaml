<UserControl x:Class="Jabil.Module.Permission.View.PermissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jabil.Module.Permission.View"
             xmlns:dto="clr-namespace:Jabil.Module.Permission.Common"
             xmlns:permission="clr-namespace:Jabil.Module.Permission"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:Jabil.Module.Permission.Common"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"  Background="White" Width="1000" Height="auto"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Jabil.Module.Permission;component/Permission.xaml" />

            </ResourceDictionary.MergedDictionaries>
            <Style  TargetType="TreeView">
                <Setter Property="BorderBrush" Value="#AAAAAA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="100"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeView}">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Grid.IsSharedSizeScope="True">

                                    <permission:MagicStackPanel 
                                        VerticalAlignment="Top"
                                        ItemHeight="{Binding ElementName=Items, Path=ActualHeight}">
                                    </permission:MagicStackPanel>
                                    <ItemsPresenter x:Name="Items" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Width" Value="100"/>
                <Setter Property="Margin" Value="20,5,10,5"/>
                <Setter Property="Background" Value="#12B1EB"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>


    </UserControl.Resources>
    <materialDesign:DialogHost Style="{StaticResource MaterialDesignEmbeddedDialogHost}" Identifier="permissionRoot">
        <Border CornerRadius="5" ClipToBounds="True">
            <Grid Background="#f3f3f4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
            Grid.Row="0" Grid.RowSpan="2"
            Margin="5,15,5,5" ClipToBounds="True" CornerRadius="5" Background="White"
            >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="权限管理" FontSize="20" VerticalAlignment="Center" FontWeight="Bold" Margin="25,5,25,5"/>

                            <StackPanel Height="50" Orientation="Horizontal" Margin="10,5">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Width" Value="100"/>
                                        <Setter Property="Margin" Value="20,5,10,5"/>
                                        <Setter Property="Background" Value="#12B1EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Button
                                Command="{Binding RunDialogCommand}"
                                CommandParameter="NewRoot">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="OpenInNew"  VerticalAlignment="Center"/>
                                        <TextBlock Text="新建" />
                                    </StackPanel>
                                </Button>
                                <!--<Button  BorderThickness="0"
                                Command="{Binding RunDialogCommand}"
                                CommandParameter="Edit">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ApplicationEdit" />
                                    <TextBlock Text="修改" />
                                </StackPanel>
                            </Button>-->

                                <Button
                                Command="{Binding RunDialogCommand}"
                                CommandParameter="NewChild">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Add"  VerticalAlignment="Center"/>

                                        <TextBlock Text="添加" />
                                    </StackPanel>
                                </Button>
                                <Button
                                
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="Update">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveCheck" />
                                        <TextBlock Text="保存" />
                                    </StackPanel>
                                </Button>

                                <Button
                                Background="#d32f2f"
                                BorderThickness="0"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="Delete"
                                >
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteForeverOutline" />
                                        <TextBlock Text="删除" />
                                    </StackPanel>
                                </Button>


                            </StackPanel>

                        </DockPanel>

                        <FrameworkElement x:Name="DataContextProxy" DataContext="{Binding}" />
                        <ScrollViewer Grid.Row="1" >
                            <TreeView Margin="5,10" BorderThickness="0" Background="White"  Tag="{Binding  RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor},Path=DataContext}"
                    ItemsSource="{Binding Source={x:Static permission:PermissionSystem.Instance},Path=PermissionTree.Children,UpdateSourceTrigger=PropertyChanged}"
                    FontSize="18">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type dto:PermissionDto}" ItemsSource="{Binding Children }" >
                                        <StackPanel Height="36" VerticalAlignment="Bottom" Orientation="Horizontal" Tag="{Binding RelativeSource={RelativeSource AncestorType=UserControl,Mode=FindAncestor},Mode=OneWay,Path=DataContext}">
                                            <TextBlock Text="{Binding TitleName}"   VerticalAlignment="Center" />
                                            <StackPanel.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}" 
                                                     Style="{StaticResource    MaterialDesignContextMenu}"
                                                     MinWidth="150" >
                                                    <MenuItem Command="{Binding RunDialogCommand}" CommandParameter="NewChild"
                                                      CommandTarget="{Binding DataContext,RelativeSource={RelativeSource Self}}" Header="新增子集">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="Newspaper"/>
                                                        </MenuItem.Icon>

                                                    </MenuItem>

                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <i:Interaction.Behaviors>
                                    <common:TreeViewSelectedItemBehavior SelectedItem="{Binding SelectedItem,Mode=TwoWay}"/>
                                </i:Interaction.Behaviors>
                                <TreeView.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Mode=Self}}" 
                                                     Style="{StaticResource    MaterialDesignContextMenu}"
                                                     MinWidth="150" FontFamily="{Binding PlacementTarget.FontFamily,RelativeSource={RelativeSource Mode=Self}}">
                                        <MenuItem Command="{Binding RunDialogCommand}" CommandParameter="NewRoot"
                                          CommandTarget="{Binding DataContext,RelativeSource={RelativeSource Self}}" Header="新建">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Newspaper"/>
                                            </MenuItem.Icon>

                                        </MenuItem>

                                    </ContextMenu>
                                </TreeView.ContextMenu>

                            </TreeView>

                        </ScrollViewer>



                    </Grid>
                </Border>

            </Grid>
        </Border>

    </materialDesign:DialogHost>
</UserControl>
