<UserControl x:Class="Jabil.Module.Permission.View.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jabil.Module.Permission.View"
             xmlns:vm="clr-namespace:Jabil.Module.Permission.ViewModel"
             xmlns:permission="clr-namespace:Jabil.Module.Permission"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conver="clr-namespace:Jabil.Module.Permission.Common"

             mc:Ignorable="d"  Background="White" Width="1000" Height="auto"
             d:DataContext="{d:DesignInstance vm:UsersViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Jabil.Module.Permission;component/Permission.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conver:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <conver:BooleanToVisibilityConverter x:Key="BoolVisConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <materialDesign:DialogHost Style="{StaticResource MaterialDesignEmbeddedDialogHost}" Identifier="userRoot">
        <Grid Background="#f3f3f4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Border
            Grid.Row="0" Grid.RowSpan="2"
            Margin="5,15,5,5" ClipToBounds="True" CornerRadius="5" Background="White"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="用户管理" FontSize="20" VerticalAlignment="Center" FontWeight="Bold" Margin="25,5,25,5"/>
                        <StackPanel Height="50" Orientation="Horizontal" Margin="10,5">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Width" Value="80"/>
                                    <Setter Property="Margin" Value="20,5,10,5"/>
                                    <Setter Property="Background" Value="#12B1EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button
                                Command="{Binding RunDialogCommand}"
                                CommandParameter="Add"
                                IsEnabled="{Binding IsEnable}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" />
                                    <TextBlock Text="新增" />
                                </StackPanel>
                            </Button>
                            <Button  BorderThickness="0"
                                Command="{Binding RunDialogCommand}"
                                CommandParameter="Edit">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ApplicationEdit" />
                                    <TextBlock Text="修改" />
                                </StackPanel>
                            </Button>


                            <Button
                                IsEnabled="{Binding IsEnable}"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="SaveChange">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveCheck" />
                                    <TextBlock Text="保存" />
                                </StackPanel>
                            </Button>
                            <Button
                                Background="#d32f2f"
                                BorderThickness="0"
                                Command="{Binding ExecuteCommand}"
                                CommandParameter="Delete"
                                IsEnabled="{Binding IsEnable}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteForeverOutline" />
                                    <TextBlock Text="删除" />
                                </StackPanel>
                            </Button>


                            <Button Width="120"
                                Background="#d32f2f"
                                BorderThickness="0"
                                    Visibility="Hidden"
                                Command="{Binding TestCommand}"
                                IsEnabled="{Binding TestCommand.IsRunning,Converter={StaticResource InverseBooleanConverter}}"
                                >
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteForeverOutline" />
                                    <TextBlock Text="Test" />
                                    <ProgressBar Width="20" Height="20"  Margin="2" Foreground="Gray"
                                                 
                                                 Visibility="{Binding TestCommand.IsRunning,Converter={StaticResource BoolVisConverter}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 IsIndeterminate="True" Value="75"/>
                                </StackPanel>
                            </Button>


                        </StackPanel>
                        <!--<StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="">
                            <Button  Background="#12B1EB" Foreground="White" Width="40"
                                        Height="40" 
                                        Margin="20,5,0,5"
                                        materialDesign:ElevationAssist.Elevation="Dp0"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#12B1EB" Foreground="White"
                                        Width="40"
                                        Height="40"
                                        Margin="20,5,0,5"
                                        materialDesign:ElevationAssist.Elevation="Dp0"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                <materialDesign:PackIcon Kind="Refresh" />
                            </Button>
                        </StackPanel>-->
                    </DockPanel>

                    <FrameworkElement x:Name="DataContextProxy" DataContext="{Binding}" />
                    <ScrollViewer  Grid.Row="1">
                        <DataGrid Margin="5,10" BorderThickness="0" Background="White" Style="{x:Null}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="All"
                    GridLinesVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    ItemsSource="{Binding Source={x:Static permission:PermissionSystem.Instance},Path=Users,UpdateSourceTrigger=Default}"
                    SelectionUnit="FullRow"
                    FontSize="18"
                    VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>

                                <DataGridCheckBoxColumn Binding="{Binding IsCheck, UpdateSourceTrigger=PropertyChanged}" >
                                    <DataGridCheckBoxColumn.Header>
                                        <Border Background="Transparent">
                                            <CheckBox IsChecked="{Binding DataContext.IsAllSelect, Source={x:Reference DataContextProxy}}" IsEnabled="{Binding DataContext.IsEnable, Source={x:Reference DataContextProxy}}" />
                                        </Border>
                                    </DataGridCheckBoxColumn.Header>
                                    <DataGridCheckBoxColumn.HeaderStyle>
                                        <Style  TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.HeaderStyle>

                                </DataGridCheckBoxColumn>


                                <DataGridTemplateColumn Header="账号" Width=".6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                        HorizontalContentAlignment="Center"
                                        BorderThickness="0"
                                        IsReadOnly="True"
                                        Text="{Binding Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="用户" Width=".6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                        HorizontalContentAlignment="Center"
                                        BorderThickness="0"
                                        IsReadOnly="{Binding IsReadOnly}"
                                        Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="角色" Width=".6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={x:Static permission:PermissionSystem.Instance},Path=Roles}"
                                                      DisplayMemberPath="RoleName" SelectedValuePath="RoleName"
                                        HorizontalContentAlignment="Center"
                                        BorderThickness="0"
                                        IsReadOnly="{Binding IsReadOnly}"
                                                      SelectedValue="{Binding RoleKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="创建时间" />
                                            <materialDesign:PackIcon
                                        Margin="5,0"
                                        Kind="Cancel"
                                        ToolTip="禁止修改" />
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                        HorizontalContentAlignment="Center"
                                        BorderThickness="0"
                                        IsReadOnly="True"
                                        Text="{Binding CreateTime}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="最后更新时间" />
                                            <materialDesign:PackIcon
                                        Margin="5,0"
                                        Kind="Cancel"
                                        ToolTip="禁止修改" />
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                        HorizontalContentAlignment="Center"
                                        BorderThickness="0"
                                        IsReadOnly="True"
                                        Text="{Binding UpdateTime}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </ScrollViewer>



                </Grid>
            </Border>

        </Grid>
    </materialDesign:DialogHost>



</UserControl>
